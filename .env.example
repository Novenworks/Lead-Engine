# LeadEngine environment.
# Copy to .env for local development. Never commit a filled-in .env —
# this repository is public.

# --- Database (Neon in production, local Postgres in development) -----------
DATABASE_URL="postgresql://user:password@host/leadengine?sslmode=require"

# --- Authentication (Clerk) -------------------------------------------------
# Required in production. Without both keys the app refuses to serve data.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Development-only auth fallback: one local operator, no sign-in.
# It is refused whenever NODE_ENV or VERCEL_ENV is "production".
# LEADENGINE_DEV_AUTH=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Business discovery provider -------------------------------------------
# "demo" returns fictional businesses so the app is usable without a key.
# "google" uses the Places API (New); without GOOGLE_MAPS_API_KEY it falls
# back to demo and the UI says so rather than pretending.
BUSINESS_DISCOVERY_PROVIDER=demo
GOOGLE_MAPS_API_KEY=

# Optional browser-side key for the map view. Restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Website preview screenshots (optional) ---------------------------------
# none | urlbox | snapsave. Previews never gate qualification.
SCREENSHOT_PROVIDER=none
URLBOX_API_KEY=
URLBOX_API_SECRET=
SNAPSAVE_API_URL=
SNAPSAVE_API_TOKEN=

# --- AuditWorkspace handoff (optional) --------------------------------------
# Without both, audit requests are recorded locally as pending and the UI
# reports the integration as unavailable.
AUDIT_WORKSPACE_API_URL=
AUDIT_WORKSPACE_API_TOKEN=

# --- Demo Factory handoff (optional) ----------------------------------------
DEMO_FACTORY_API_URL=
DEMO_FACTORY_API_TOKEN=

# --- Background worker ------------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2

# --- Test database (used by pnpm test and CI) -------------------------------
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/leadengine_test"
