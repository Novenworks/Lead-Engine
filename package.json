{
  "name": "leadengine",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter @leadengine/web run dev",
    "dev:worker": "pnpm --filter @leadengine/worker run dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @leadengine/db run generate",
    "db:migrate": "pnpm --filter @leadengine/db run migrate",
    "db:push": "pnpm --filter @leadengine/db run push",
    "db:seed": "pnpm --filter @leadengine/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
